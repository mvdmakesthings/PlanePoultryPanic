extends Node
## Plays sound effects, ambience and music (autoload: AudioManager).
##
## Sounds live in assets/audio/ and are generated by tools/audio/build.py.
## Three buses feed Master, so Settings can set each volume on its own:
##   Music     - the soundtrack
##   Effects   - one-shot sounds (steps, pickups, chickens, doors)
##   Ambience  - looping machinery like the carousel's hum
##
## play("cluck", position) plays a sound in the world, quieter the further
## it is from the camera; play("pickup") without a position plays it flat.

const BUSES: Array[String] = ["Music", "Effects", "Ambience"]
const SFX_DIR := "res://assets/audio/sfx/"
const MUSIC_DIR := "res://assets/audio/music/"
## Per-sound volume trim (dB) and random pitch spread, so repeated sounds
## don't sound robotic. Sounds not listed play as recorded.
const SOUNDS := {
	"step": {"db": -10.0, "pitch": 0.12},
	"pickup": {"db": -2.0, "pitch": 0.05},
	"throw": {"db": 0.0, "pitch": 0.1},
	"eat": {"db": 0.0, "pitch": 0.05},
	"hurt": {"db": -3.0, "pitch": 0.05},
	"peck": {"db": -2.0, "pitch": 0.15},
	"splat": {"db": -2.0, "pitch": 0.1},
	"poof": {"db": 0.0, "pitch": 0.1},
	"cluck": {"db": -4.0, "pitch": 0.15},
	"spray": {"db": 0.0, "pitch": 0.05},
	"shove": {"db": -2.0, "pitch": 0.1},
	"locked": {"db": -2.0, "pitch": 0.0},
	"door": {"db": -4.0, "pitch": 0.05},
	"closet": {"db": -2.0, "pitch": 0.1},
}
## How many sounds can play at once, flat and in the world.
const POOL_SIZE := 12
## Beyond this distance from the camera, world sounds are silent.
const HEARING_DISTANCE := 360.0
const DEFAULT_VOLUMES := {"Music": 0.6, "Effects": 0.8, "Ambience": 0.7}

var _streams := {}
var _flat: Array[AudioStreamPlayer] = []
var _world: Array[AudioStreamPlayer2D] = []
var _loops: Array[AudioStreamPlayer2D] = []
var _next_flat := 0
var _next_world := 0
var _music: AudioStreamPlayer
var _music_name := ""


func _ready() -> void:
	# Menus play sounds while the game is paused.
	process_mode = Node.PROCESS_MODE_ALWAYS
	for bus in BUSES:
		if AudioServer.get_bus_index(bus) < 0:
			AudioServer.add_bus()
			var index := AudioServer.bus_count - 1
			AudioServer.set_bus_name(index, bus)
			AudioServer.set_bus_send(index, "Master")
		set_volume(bus, DEFAULT_VOLUMES[bus])
	for i in POOL_SIZE:
		var flat := AudioStreamPlayer.new()
		flat.bus = "Effects"
		add_child(flat)
		_flat.append(flat)
		var world := AudioStreamPlayer2D.new()
		world.bus = "Effects"
		world.max_distance = HEARING_DISTANCE
		add_child(world)
		_world.append(world)
	_music = AudioStreamPlayer.new()
	_music.bus = "Music"
	add_child(_music)


func _exit_tree() -> void:
	_release_all()


## Stops every sound and waits for the audio thread to let go of them.
## Await this before quitting, or sounds still playing leak at exit.
func silence() -> void:
	_release_all()
	# The audio thread lets go of stopped sounds on its next mix, which can
	# be several frames away when frames are fast, so wait in real time.
	await get_tree().create_timer(0.2, true, false, true).timeout


func _release_all() -> void:
	_music_name = ""
	var players: Array[Node] = [_music]
	players.append_array(_flat)
	players.append_array(_world)
	players.append_array(_loops)
	for player in players:
		player.stop()
		player.stream = null


## Plays a sound effect by name. With a position, it plays at that spot in
## the world; without one, it plays at full volume everywhere.
func play(sound: String, at: Variant = null) -> void:
	var stream := _stream(SFX_DIR, sound)
	if stream == null:
		return
	var info: Dictionary = SOUNDS.get(sound, {})
	var pitch := 1.0 + randf_range(-1.0, 1.0) * float(info.get("pitch", 0.0))
	var db := float(info.get("db", 0.0))
	if at is Vector2:
		var player := _pick(_world, _next_world) as AudioStreamPlayer2D
		_next_world = (_next_world + 1) % POOL_SIZE
		player.global_position = at
		_start(player, stream, db, pitch)
	else:
		var player := _pick(_flat, _next_flat) as AudioStreamPlayer
		_next_flat = (_next_flat + 1) % POOL_SIZE
		_start(player, stream, db, pitch)


## Plays a looping sound at a spot in the world, like the carousel's hum,
## until owner leaves the scene. The players for loops belong to this
## manager and are reused, so a level being freed never cuts one off
## mid-play (which leaks the sound at exit).
func play_loop(sound: String, owner: Node, at: Vector2, bus := "Ambience") -> void:
	var player: AudioStreamPlayer2D = null
	for candidate in _loops:
		if not candidate.playing:
			player = candidate
			break
	if player == null:
		player = AudioStreamPlayer2D.new()
		player.max_distance = HEARING_DISTANCE
		add_child(player)
		_loops.append(player)
	player.stream = _looping(_stream(SFX_DIR, sound))
	player.bus = bus
	player.global_position = at
	player.play()
	owner.tree_exiting.connect(player.stop)


## Looping sounds playing right now, for tests.
func playing_loops() -> Array[AudioStreamPlayer2D]:
	return _loops.filter(func(p: AudioStreamPlayer2D) -> bool: return p.playing)


## Starts a music track by name (it loops). Does nothing if it's already playing.
func play_music(track: String) -> void:
	if track == _music_name and _music.playing:
		return
	_music_name = track
	_music.stream = _looping(_stream(MUSIC_DIR, track))
	_music.play()


func stop_music() -> void:
	_music_name = ""
	_music.stop()


func music_playing() -> String:
	return _music_name if _music.playing else ""


## Sets a bus's volume, 0 (silent) to 1 (full).
func set_volume(bus: String, linear: float) -> void:
	var index := AudioServer.get_bus_index(bus)
	AudioServer.set_bus_volume_db(index, linear_to_db(maxf(linear, 0.0001)))
	AudioServer.set_bus_mute(index, linear <= 0.0)


func get_volume(bus: String) -> float:
	var index := AudioServer.get_bus_index(bus)
	if AudioServer.is_bus_mute(index):
		return 0.0
	return snappedf(db_to_linear(AudioServer.get_bus_volume_db(index)), 0.01)


func _stream(folder: String, sound: String) -> AudioStream:
	var path := folder + sound + ".wav"
	if not _streams.has(path):
		if not ResourceLoader.exists(path):
			push_warning("No sound named %s" % path)
			_streams[path] = null
		else:
			_streams[path] = load(path)
	return _streams[path]


## Makes a WAV loop over its whole length.
func _looping(stream: AudioStream) -> AudioStream:
	var wav := stream as AudioStreamWAV
	if wav and wav.loop_mode != AudioStreamWAV.LOOP_FORWARD:
		wav.loop_mode = AudioStreamWAV.LOOP_FORWARD
		wav.loop_begin = 0
		wav.loop_end = int(roundf(wav.get_length() * wav.mix_rate))
	return stream


## The next player in the pool, skipping ones still playing if possible.
func _pick(pool: Array, start: int) -> Node:
	for i in pool.size():
		var candidate: Node = pool[(start + i) % pool.size()]
		if not candidate.playing:
			return candidate
	return pool[start]


func _start(player: Node, stream: AudioStream, db: float, pitch: float) -> void:
	player.stream = stream
	player.volume_db = db
	player.pitch_scale = pitch
	player.play()
