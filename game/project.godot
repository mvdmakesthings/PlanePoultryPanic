; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Plane Poultry Panic"
config/description="Escape a chicken-overrun airport terminal and catch the last flight out."
run/main_scene="res://scenes/levels/prototype_room.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

InputSetup="*res://scripts/managers/input_setup.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[gui]

theme/default_font_antialiasing=0

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="chickens"
2d_physics/layer_4="player_blockers"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
